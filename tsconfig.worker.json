{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "worker/**/*.ts",
    "lib/env.ts",
    "lib/types.ts",
    "lib/time.ts",
    "lib/signals.ts",
    "lib/candles.ts",
    "lib/sqlite.ts",
    "lib/node-sqlite.d.ts",
    "lib/breadth.ts",
    "lib/store.ts"
  ]
}
