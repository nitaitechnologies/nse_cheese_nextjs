# Copy to .env on this PC. In Coolify, enter the same keys as runtime
# environment variables. Do not commit real values.

# Optional. When unset, this PC uses data/nse.sqlite.
# In Coolify set SQLITE_PATH=/app/data/nse.sqlite and mount a volume at /app/data.
# SQLITE_PATH=data/nse.sqlite

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# Generate both with: npm run hash-password -- your-password
# Coolify accepts either key. Prefer the base64 form.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_PASSWORD_HASH_B64=

KITE_API_KEY=
KITE_API_SECRET=
# Must match the Kite app Redirect URL exactly.
# Zerodha allows plain HTTP only on 127.0.0.1. The server must be HTTPS.
# Local:  http://127.0.0.1:3000/api/kite/callback
# Server: https://your-domain/api/kite/callback
KITE_REDIRECT_URL=http://127.0.0.1:3000/api/kite/callback

PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Local worker. Coolify starts the worker inside the same container, on 127.0.0.1.
WORKER_INTERNAL_URL=http://127.0.0.1:4001
WORKER_PORT=4001
TZ=Asia/Kolkata
