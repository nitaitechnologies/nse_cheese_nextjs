# Local development. On Coolify, enter these under the app's Environment Variables.
# Do not commit real values. Compose interpolates $, so a value that contains $
# must be stored as $$ in Coolify, or the container receives a broken string.

# Database name in this URI is ignored when MONGODB_DB is set.
MONGODB_URI=mongodb://localhost:27017/nse_cheese
MONGODB_DB=nse_cheese
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string
# bcrypt hashes contain $. On Coolify set only the base64 form.
# Generate both with: npm run hash-password -- your-password
DASHBOARD_PASSWORD_HASH=
DASHBOARD_PASSWORD_HASH_B64=
KITE_API_KEY=
KITE_API_SECRET=
# Must match the Kite app Redirect URL exactly, including scheme, host, and path.
# Zerodha allows plain HTTP only on 127.0.0.1. Production must be HTTPS.
# Local:      http://127.0.0.1:3000/api/kite/callback
# Production: https://your-domain/api/kite/callback
KITE_REDIRECT_URL=http://127.0.0.1:3000/api/kite/callback
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Local worker. Coolify Compose sets this to http://worker:4001 for the web service.
WORKER_INTERNAL_URL=http://127.0.0.1:4001
WORKER_PORT=4001
TZ=Asia/Kolkata
